{
  "expo": {
    "name": "Wolof Translator",
    "slug": "wolof-translator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00853F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wolof.translator"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00853F"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.wolof.translator"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "description": "Application de traduction Wolof - Dictionnaire complet avec traductions en Français, Anglais, Arabe et Espagnol. Fonctionne hors-ligne.",
    "githubUrl": "https://github.com/Full-Gor/wolof",
    "primaryColor": "#00853F"
  }
}
